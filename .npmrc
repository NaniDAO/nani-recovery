# Exact versions on install, so `pnpm add` can't reintroduce a caret range and
# quietly widen what a fresh install may pull.
save-exact=true

# Don't install anything published in the last week.
#
# Nearly every npm compromise in recent memory followed the same shape: a
# maintainer account is taken over, a malicious patch goes out, and it is caught
# and unpublished within hours to days. A version range that resolves to
# "whatever is newest" is what turns that window into an incident. Waiting it out
# costs nothing here — this page's dependencies are not in a hurry.
minimum-release-age=10080
